{
  "name": "invoicepilot",
  "version": "0.1.0",
  "license": "MIT",
  "description": "AI-assisted invoicing and payment management workspace (PayPal AI Hackathon)",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/dev.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "paypal:sandbox:verify": "tsx src/server/paypal/verifySandboxCli.ts",
    "paypal:adapter:verify": "tsx src/server/paypal/verifyAdapterCli.ts",
    "db:migrate": "tsx src/server/db/migrateAndSeedCli.ts migrate",
    "db:migrate:supabase": "tsx src/server/db/supabaseMigrationCli.ts",
    "db:seed:demo": "tsx src/server/db/migrateAndSeedCli.ts seed-demo"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
